// Prisma schema for Classroom course management
// Uses PostgreSQL as the datasource

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Local user profile overrides ──
model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique // App session user ID
  displayName String   @default("")
  avatar      String   @default("")
  role        String   @default("")
  email       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([role])
}

// ── Course ──
model Course {
  id             String    @id @default(uuid())
  roomUuid       String?   @unique // Provider channel ID; name retained for backward-compatible migration
  classroomProvider String @default("agora")
  recordingProvider String @default("agora")
  name           String
  description    String    @default("")
  roomType       Int       @default(0) // 0=一对一, 4=小班, 2=大班, 10=公开课
  passcode       String?   // 6-digit passcode for public course
  ownerId        String    // Course owner Casdoor user ID
  ownerName      String
  ownerAvatar    String    @default("")
  teacherId      String    // Casdoor user ID
  teacherName    String
  teacherAvatar  String    @default("")
  status         String    @default("scheduled") // scheduled | live | afterClass | cancelled | finished
  startTime      DateTime?
  endTime        DateTime?
  endedAt        DateTime? // Platform after-class time; scheduled endTime controls auto-finish
  studentRemarks String    @default("")
  recordUrl      String?   // Authenticated internal or external recording playback URL
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  students     CourseStudent[]
  groupLinks   CourseGroupLink[]
  joinLinks    CourseJoinLink[]
  courseware   Courseware[]
  teachers     CourseTeacher[]
  attendances  CourseAttendance[]
  recordings   ClassroomRecording[]
  classroomRuntime ClassroomRuntime?
  classroomMembers ClassroomMemberState[]
  classroomMessages ClassroomMessage[]
  classroomCaptions ClassroomCaption[]
  classroomSpaces ClassroomSpace[]
  classroomSpaceMembers ClassroomSpaceMember[]
  classroomQuestions ClassroomQuestion[]

  @@index([ownerId])
  @@index([teacherId])
  @@index([status])
}

// ── Provider-neutral classroom recording attempts ──
model ClassroomRecording {
  id                String    @id @default(uuid())
  courseId          String
  provider          String
  channelName       String
  recorderUserId    String
  status            String    @default("starting") // starting | recording | stopping | completed | failed
  resourceId        String?
  providerSessionId String?   // Agora sid or another provider's recording session ID
  playbackObjectKey String?
  files             Json?
  providerState     Json?
  errorMessage      String?
  mode              String    @default("mix") // web | mix
  fallbackFrom      String?
  retryCount        Int       @default(0)
  startedAt         DateTime?
  stoppedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([courseId, status])
  @@index([providerSessionId])
}

// ── Course ↔ Teacher (lecturers; includes the lead teacher) ──
model CourseTeacher {
  id          String   @id @default(uuid())
  courseId    String
  teacherId   String   // Casdoor user ID
  teacherName String   @default("")
  teacherAvatar String @default("")
  createdAt   DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, teacherId])
  @@index([teacherId])
  @@index([courseId])
}

// ── Share link: teacher-created, revocable live or course enrollment link ──
model CourseJoinLink {
  id         String    @id @default(uuid())
  courseId   String
  token      String    @unique
  purpose    String    @default("live") // live | course
  passcode   String?   // Optional 6-digit passcode required before using this share link
  label      String    @default("")
  createdBy  String
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  useCount   Int       @default(0)
  createdAt  DateTime  @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([courseId, purpose])
  @@index([createdBy])
}

// ── Student Group (supports nested hierarchy) ──
model StudentGroup {
  id        String   @id @default(uuid())
  name      String
  parentId  String?  // null = root group
  createdBy String   // Teacher Casdoor user ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Self-relation for hierarchy
  parent   StudentGroup?  @relation("GroupHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children StudentGroup[] @relation("GroupHierarchy")

  // Relations
  members    GroupMember[]
  courseLinks CourseGroupLink[]

  @@index([parentId])
  @@index([createdBy])
}

// ── Course ↔ Student (direct assignment) ──
model CourseStudent {
  id        String   @id @default(uuid())
  courseId   String
  studentId String   // Casdoor user ID
  studentName String @default("")
  studentAvatar String @default("")
  joinedAt  DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId])
}

// ── Student classroom attendance sessions ──
model CourseAttendance {
  id            String    @id @default(uuid())
  courseId      String
  studentId     String
  studentName   String    @default("")
  studentAvatar String    @default("")
  enteredAt     DateTime  @default(now())
  leftAt        DateTime?
  durationSec   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([studentId])
  @@index([courseId, studentId])
  @@index([courseId, enteredAt])
}

// ── Course ↔ StudentGroup (group assignment) ──
model CourseGroupLink {
  id       String @id @default(uuid())
  courseId  String
  groupId  String
  linkedAt DateTime @default(now())

  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  group  StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([courseId, groupId])
}

// ── Group ↔ Member ──
model GroupMember {
  id        String   @id @default(uuid())
  groupId   String
  userId    String   // Casdoor user ID
  userName  String   @default("")
  userAvatar String  @default("")
  joinedAt  DateTime @default(now())

  group StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

// ── Courseware (Whiteboard materials / slides) ──
model Courseware {
  id          String   @id @default(uuid())
  courseId    String
  name        String
  ext         String   // pdf, ppt, pptx, doc, docx, mp3, mp4, png, jpg, gif
  size        Int      @default(0) // size in bytes
  url         String   // Original or converted entry URL
  taskUuid    String?  // Agora projector task UUID
  taskStatus  String   @default("Pending") // Pending | Converting | Finished | Failed
  type        String   @default("static") // static | dynamic
  conversion  Json?    // Store full Agora conversion JSON response (scenes/pages)
  studentCanView     Boolean  @default(true)
  studentCanDownload Boolean  @default(true)
  whiteboardEnabled  Boolean  @default(false)
  conversionError    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

// ── Authoritative live classroom state ──
model ClassroomRuntime {
  id                 String    @id @default(uuid())
  courseId           String    @unique
  status             String    @default("waiting") // waiting | live | ended
  revision           Int       @default(1)
  startedAt          DateTime?
  graceEndsAt        DateTime?
  stageMode          String    @default("auto") // auto | screen | whiteboard | spotlight
  stageLocked        Boolean   @default(false)
  spotlightUserId    String?
  activeCoursewareId String?
  chatEnabled        Boolean   @default(true)
  timerStartedAt     DateTime?
  timerDurationSec   Int?
  timerPausedAt      DateTime?
  interpretationEnabled  Boolean   @default(false)
  interpretationProvider String    @default("shengwang") // shengwang | wordly
  sourceLanguage         String    @default("zh-CN")
  targetLanguages        Json      @default("[]")
  transcriptionStatus    String    @default("stopped") // stopped | starting | running | failed
  transcriptionAgentId   String?
  transcriptionError     String?
  whiteboardProvider String    @default("netless")
  whiteboardRoomUuid String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  course   Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  members  ClassroomMemberState[]
  messages ClassroomMessage[]
  captions ClassroomCaption[]

  @@index([status])
  @@index([graceEndsAt])
}

model ClassroomMemberState {
  id                 String    @id @default(uuid())
  runtimeId          String
  courseId           String
  userId             String
  displayName        String    @default("")
  avatar             String    @default("")
  role               String    @default("student") // teacher | assistant | student
  presence           String    @default("offline") // online | offline
  stageState         String    @default("offstage") // offstage | invited | accepted
  onStage            Boolean   @default(false)
  microphoneAllowed  Boolean   @default(false)
  cameraAllowed      Boolean   @default(false)
  chatMuted          Boolean   @default(false)
  whiteboardWritable Boolean   @default(false)
  handRaisedAt       DateTime?
  joinedAt           DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  runtime ClassroomRuntime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  course  Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([runtimeId, presence])
  @@index([courseId, handRaisedAt])
  @@index([courseId, onStage])
}

model ClassroomMessage {
  id         String    @id @default(uuid())
  runtimeId  String
  courseId   String
  senderId   String
  senderName String
  senderRole String
  spaceId    String?
  scope      String    @default("classroom") // classroom | room | staff | direct
  recipientId String?
  kind       String    @default("text") // text | system
  content    String
  deletedAt  DateTime?
  deletedBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  runtime ClassroomRuntime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  course  Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  space   ClassroomSpace?  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
  @@index([runtimeId, createdAt])
  @@index([spaceId, createdAt])
  @@index([courseId, scope, createdAt])
}

// ── Large-class orchestration spaces ──
// RTC channels remain provider-neutral strings. A large class keeps one main
// broadcast and may add independent breakout spaces with their own assistant,
// roster, whiteboard and question queue.
model ClassroomSpace {
  id                 String   @id @default(uuid())
  courseId           String
  kind               String   @default("breakout") // main | breakout
  name               String
  channelName        String   @unique
  status             String   @default("waiting") // waiting | open | closed
  position           Int
  capacity           Int?
  whiteboardRoomUuid String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  course    Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  members   ClassroomSpaceMember[]
  messages  ClassroomMessage[]
  questions ClassroomQuestion[]

  @@unique([courseId, position])
  @@index([courseId, status])
}

model ClassroomSpaceMember {
  id          String    @id @default(uuid())
  courseId    String
  spaceId     String
  userId      String
  displayName String    @default("")
  avatar      String    @default("")
  role        String    @default("student") // assistant | student
  active      Boolean   @default(true)
  microphoneAllowed Boolean @default(true)
  cameraAllowed     Boolean @default(true)
  screenShareAllowed Boolean @default(false)
  assignedAt  DateTime  @default(now())
  joinedAt    DateTime?
  leftAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  course Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  space  ClassroomSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([courseId, userId])
  @@index([spaceId, role, active])
}

model ClassroomQuestion {
  id          String    @id @default(uuid())
  courseId    String
  spaceId     String?
  askerId     String
  askerName   String    @default("")
  content     String
  status      String    @default("open") // open | promoted | answered | dismissed
  promotedBy  String?
  answeredBy  String?
  answer      String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  course Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  space  ClassroomSpace? @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([courseId, status, createdAt])
  @@index([spaceId, status, createdAt])
}

// ── Provider-neutral ASR captions and translated text ──
model ClassroomCaption {
  id             String    @id @default(uuid())
  runtimeId      String
  courseId       String
  externalId     String
  provider       String    @default("shengwang")
  speakerId      String    @default("")
  speakerName    String    @default("")
  sourceLanguage String    @default("")
  detectedLanguage String  @default("")
  text           String
  translations   Json      @default("{}")
  isFinal        Boolean   @default(false)
  occurredAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  runtime ClassroomRuntime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  course  Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, externalId])
  @@index([courseId, occurredAt])
  @@index([runtimeId, occurredAt])
}
