// Prisma schema for Classroom course management
// Uses PostgreSQL as the datasource

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Local user profile overrides ──
model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique // App session user ID
  displayName String   @default("")
  avatar      String   @default("")
  role        String   @default("")
  email       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([role])
}

// ── Teacher-authored availability and busy plans ──
// Concrete time blocks keep scheduling queries predictable across timezones.
// `available` blocks are recommendations; `busy` blocks are hard conflicts.
model TeacherScheduleBlock {
  id        String   @id @default(uuid())
  teacherId String
  kind      String   @default("busy") // available | busy
  title     String   @default("")
  startTime DateTime
  endTime   DateTime
  timezone  String   @default("Asia/Shanghai")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId, startTime])
  @@index([teacherId, endTime])
}

// ── Course ──
model Course {
  id                String    @id @default(uuid())
  roomUuid          String?   @unique // Provider channel ID; name retained for backward-compatible migration
  classroomProvider String    @default("agora")
  recordingProvider String    @default("agora")
  name              String
  description       String    @default("")
  roomType          Int       @default(0) // 0=一对一, 4=小班, 2=大班, 10=公开课
  captionStartPreferences Json @default("{}")
  autoStudentOnStage Boolean? // null keeps the pre-setting behavior for existing courses
  passcode          String? // 6-digit passcode for public course
  ownerId           String // Course owner Casdoor user ID
  ownerName         String
  ownerAvatar       String    @default("")
  teacherId         String // Casdoor user ID
  teacherName       String
  teacherAvatar     String    @default("")
  status            String    @default("scheduled") // scheduled | live | afterClass | cancelled | finished
  lifecycleStatus   String    @default("active") // draft | active | archived
  courseKind        String    @default("series") // series | standalone
  startTime         DateTime?
  endTime           DateTime?
  endedAt           DateTime? // Platform after-class time; scheduled endTime controls auto-finish
  studentRemarks    String    @default("")
  recordUrl         String? // Authenticated internal or external recording playback URL
  creationRequestId String?   @unique // Client-generated idempotency key for create
  publicApiManaged  Boolean   @default(false) // Anonymous REST API manages only explicitly public courses
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  students                  CourseStudent[]
  groupLinks                CourseGroupLink[]
  joinLinks                 CourseJoinLink[]
  courseware                Courseware[]
  teachers                  CourseTeacher[]
  attendances               CourseAttendance[]
  recordings                ClassroomRecording[]
  classroomRuntimes         ClassroomRuntime[]
  classroomMembers          ClassroomMemberState[]
  classroomMessages         ClassroomMessage[]
  classroomCaptions         ClassroomCaption[]
  classroomSpaces           ClassroomSpace[]
  classroomSpaceMembers     ClassroomSpaceMember[]
  classroomQuestions        ClassroomQuestion[]
  classroomRewardEvents     ClassroomRewardEvent[]
  classroomEngagementRounds ClassroomEngagementRound[]
  sessions                  CourseSession[]
  sessionSeries             CourseSessionSeries[]
  programs                  CourseProgram[]
  sessionCreationRequests   CourseSessionCreationRequest[]
  assignmentDrafts          CourseAssignmentDraft[]
  assignmentCreationReceipts CourseAssignmentCreationReceipt[]
  publishedAssignments      CoursePublishedAssignment[]
  programResources          CourseProgramResource[]
  programUnits              CourseProgramUnit[]
  sessionTeacherRules       CourseSessionTeacher[]
  sessionStudentRules       CourseSessionStudent[]
  sessionGroupRules         CourseSessionGroupLink[]
  sessionCoursewareRules    CourseSessionCourseware[]
  sessionStudentSubmissions CourseSessionStudentSubmission[]
  sessionSummaries          CourseSessionSummary[]
  playbackProgress          CoursePlaybackProgress[]
  workspaceMessages         WorkspaceMessage[]
  workspaceChatReads         WorkspaceChatRead[]
  workspaceTasks             WorkspaceTask[]
  workspaceDirectChats       WorkspaceDirectChat[]

  @@index([ownerId])
  @@index([teacherId])
  @@index([status])
  @@index([publicApiManaged, id])
}

// Successful anonymous create responses persist with their request digest.
// No relation: request retries retain the original result after deletion.
model PublicApiRequest {
  id          String   @id
  requestHash String
  response    Json
  createdAt   DateTime @default(now())
}

// ── Course → scheduled lesson/session ──
// Course keeps the long-lived roster and content library. Every live lesson has
// an independent provider room, runtime, attendance, recording and whiteboard.
model CourseSession {
  id                String    @id @default(uuid())
  courseId          String
  seriesId          String?
  programId         String?
  unitId            String?
  title             String    @default("")
  position          Int
  roomUuid          String    @unique
  roomType          Int
  classroomProvider String    @default("agora")
  recordingProvider String    @default("agora")
  teacherMode       String    @default("inherit") // inherit | custom
  studentMode       String    @default("inherit") // inherit | custom
  leadTeacherId     String?
  leadTeacherName   String    @default("")
  leadTeacherAvatar String    @default("")
  status            String    @default("scheduled") // scheduled | live | afterClass | cancelled | finished
  timezone          String?   // Original scheduling zone; null for legacy lessons
  startTime         DateTime
  endTime           DateTime
  endedAt           DateTime?
  isDetached        Boolean   @default(false)
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  course                    Course                     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  cacheVersions             ClassroomCacheVersion[]
  series                    CourseSessionSeries?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  program                   CourseProgram?             @relation(fields: [programId, courseId], references: [id, courseId], onDelete: NoAction)
  unit                      CourseProgramUnit?         @relation(fields: [unitId, courseId], references: [id, courseId], onDelete: NoAction)
  teachers                  CourseSessionTeacher[]
  students                  CourseSessionStudent[]
  groupLinks                CourseSessionGroupLink[]
  coursewareRules           CourseSessionCourseware[]
  joinLinks                 CourseJoinLink[]
  courseware                Courseware[]
  recordings                ClassroomRecording[]
  attendances               CourseAttendance[]
  classroomRuntime          ClassroomRuntime?
  classroomMembers          ClassroomMemberState[]
  classroomMessages         ClassroomMessage[]
  chatImages                ClassroomChatImage[]
  screenInkAssets           ClassroomScreenInkAsset[]
  classroomCaptions         ClassroomCaption[]
  classroomSpaces           ClassroomSpace[]
  classroomSpaceMembers     ClassroomSpaceMember[]
  classroomQuestions        ClassroomQuestion[]
  classroomRewardEvents     ClassroomRewardEvent[]
  classroomEngagementRounds ClassroomEngagementRound[]
  studentSubmissions        CourseSessionStudentSubmission[]
  summary                   CourseSessionSummary?
  summaryGeneration         CourseSessionSummaryGeneration?
  workspaceTasks            WorkspaceTask[]
  remoteControlGrants       ClassroomRemoteControlGrant[]

  @@unique([courseId, position])
  @@index([courseId, startTime])
  @@index([courseId, status])
  @@index([seriesId, startTime])
  @@index([courseId, programId, startTime])
  @@index([leadTeacherId, startTime])
}

// Durable, signed third-party lifecycle notifications. Retained independently
// of course deletion so committed notifications can finish delivery.
model ClassroomIntegrationEvent {
  id            String    @id
  dedupeKey     String    @unique
  sessionId     String
  payload       Json
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  deliveredAt   DateTime?
  lockedUntil   DateTime?
  claim         String?
  lastError     String?
  createdAt     DateTime  @default(now())

  @@index([deliveredAt, nextAttemptAt])
  @@index([sessionId, createdAt])
}

// A class may organize lessons into several teaching programs. Recurrence
// series remain independent from the teaching program assignment.
// Drafts are teacher-only and are not published to learners.
// Published course resources are independent snapshots of teacher drive files.
// Unit scope is checked alongside program membership by every write endpoint.
model CourseProgramUnit {
  id String @id @default(uuid())
  courseId String
  programId String?
  creatorId String
  requestId String
  name String
  version Int @default(0)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course Course @relation(fields:[courseId], references:[id], onDelete:Cascade)
  program CourseProgram? @relation(fields:[programId, courseId], references:[id, courseId], onDelete:NoAction)
  sessions CourseSession[]
  resources CourseProgramResource[]
  drafts CourseAssignmentDraft[]
  publishedAssignments CoursePublishedAssignment[]
  @@unique([id, courseId])
  @@unique([courseId, creatorId, requestId])
  @@index([courseId, programId, createdAt])
  @@index([courseId, programId, sortOrder, createdAt])
}

model CourseProgramResource {
  id String @id @default(uuid())
  courseId String
  programId String?
  unitId String?
  creatorId String
  requestId String
  sourceId String
  sourceObjectKey String
  objectKey String @unique
  name String
  size Int
  status String @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course Course @relation(fields:[courseId], references:[id], onDelete:Cascade)
  program CourseProgram? @relation(fields:[programId, courseId], references:[id, courseId], onDelete:NoAction)
  unit CourseProgramUnit? @relation(fields:[unitId, courseId], references:[id, courseId], onDelete:NoAction)
  @@unique([courseId, creatorId, requestId])
  @@index([courseId, programId, status, createdAt])
}

model CourseAssignmentDraft {
  id String @id @default(uuid())
  courseId String
  programId String?
  unitId String?
  creatorId String
  requestId String
  title String
  description String @default("")
  dueDate String?
  version Int @default(0)
  lastEditRequestId String?
  lastEditActorId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course Course @relation(fields:[courseId], references:[id], onDelete:Cascade)
  program CourseProgram? @relation(fields:[programId, courseId], references:[id, courseId], onDelete:NoAction)
  unit CourseProgramUnit? @relation(fields:[unitId, courseId], references:[id, courseId], onDelete:NoAction)
  @@unique([courseId, creatorId, requestId])
  @@index([courseId, programId, createdAt])
}

// Keep creation receipts after edits, moves, or deletion to make retries safe.
model CourseAssignmentCreationReceipt {
  courseId String
  creatorId String
  requestId String
  draftId String
  programId String?
  unitId String?
  title String
  description String
  dueDate String?
  createdAt DateTime @default(now())
  course Course @relation(fields:[courseId], references:[id], onDelete:Cascade)

  @@id([courseId, creatorId, requestId])
}

// Published assignments are snapshots: editing a teacher-only draft cannot
// silently change work that has already been delivered to students.
model CoursePublishedAssignment {
  id String @id @default(uuid())
  courseId String
  programId String?
  unitId String?
  sourceDraftId String @unique
  sourceVersion Int
  publisherId String
  requestId String
  title String
  description String
  dueDate String?
  publishedAt DateTime @default(now())
  course Course @relation(fields:[courseId], references:[id], onDelete:Cascade)
  program CourseProgram? @relation(fields:[programId, courseId], references:[id, courseId], onDelete:NoAction)
  unit CourseProgramUnit? @relation(fields:[unitId, courseId], references:[id, courseId], onDelete:NoAction)
  submissions CourseAssignmentSubmission[]
  submissionReceipts CourseAssignmentSubmissionReceipt[]
  @@unique([courseId, publisherId, requestId])
  @@index([courseId, programId, unitId, publishedAt])
}

model CourseAssignmentSubmission {
  id String @id @default(uuid())
  assignmentId String
  studentId String
  studentName String
  content String
  version Int @default(0)
  submittedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignment CoursePublishedAssignment @relation(fields:[assignmentId], references:[id], onDelete:Cascade)
  review CourseAssignmentReview?
  reviewReceipts CourseAssignmentReviewReceipt[]
  @@unique([assignmentId, studentId])
  @@index([assignmentId, submittedAt, id])
}

model CourseAssignmentReview {
  id String @id @default(uuid())
  submissionId String @unique
  submissionVersion Int
  reviewerId String
  reviewerName String
  result String
  feedback String @default("")
  version Int @default(0)
  updatedAt DateTime @updatedAt
  submission CourseAssignmentSubmission @relation(fields:[submissionId], references:[id], onDelete:Cascade)
}

model CourseAssignmentReviewReceipt {
  submissionId String
  reviewerId String
  requestId String
  submissionVersion Int
  expectedVersion Int?
  result String
  feedback String
  createdAt DateTime @default(now())
  submission CourseAssignmentSubmission @relation(fields:[submissionId], references:[id], onDelete:Cascade)
  @@id([submissionId, reviewerId, requestId])
}

// A receipt outlives subsequent edits and makes a lost response safe to retry.
model CourseAssignmentSubmissionReceipt {
  assignmentId String
  studentId String
  requestId String
  content String
  expectedVersion Int?
  resultVersion Int
  createdAt DateTime @default(now())
  assignment CoursePublishedAssignment @relation(fields:[assignmentId], references:[id], onDelete:Cascade)
  @@id([assignmentId, studentId, requestId])
}

model CourseSessionCreationRequest {
  courseId String
  requestId String
  creatorId String
  fingerprint String
  sessionIds Json
  createdAt DateTime @default(now())
  course Course @relation(fields:[courseId], references:[id], onDelete:Cascade)
  @@id([courseId, requestId])
}

model CourseProgram {
  id String @id @default(uuid())
  courseId String
  name String
  requestId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course Course @relation(fields:[courseId], references:[id], onDelete:Cascade)
  sessions CourseSession[]
  assignmentDrafts CourseAssignmentDraft[]
  publishedAssignments CoursePublishedAssignment[]
  resources CourseProgramResource[]
  units CourseProgramUnit[]
  @@unique([id, courseId])
  @@unique([courseId, name])
  @@unique([courseId, requestId])
  @@index([courseId, createdAt])
}

model CourseSessionSeries {
  id              String   @id @default(uuid())
  courseId        String
  timezone        String
  recurrenceRule  Json
  durationMinutes Int
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course   Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sessions CourseSession[]

  @@index([courseId])
}

model CourseSessionTeacher {
  id            String   @id @default(uuid())
  courseId      String
  sessionId     String
  teacherId     String
  teacherName   String   @default("")
  teacherAvatar String   @default("")
  action        String   @default("include") // include | exclude
  role          String   @default("assistant") // teacher | assistant
  createdAt     DateTime @default(now())

  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, teacherId])
  @@index([courseId, teacherId])
}

model CourseSessionStudent {
  id            String   @id @default(uuid())
  courseId      String
  sessionId     String
  studentId     String
  studentName   String   @default("")
  studentAvatar String   @default("")
  action        String   @default("include") // include | exclude
  createdAt     DateTime @default(now())

  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([courseId, studentId])
}

// Per-student, per-lesson requests. This is intentionally separate from
// CourseSessionStudent: roster rules control access, while a submission must
// never grant or preserve lesson membership.
model CourseSessionStudentSubmission {
  id                String    @id @default(uuid())
  courseId          String
  sessionId         String
  studentId         String
  studentName       String    @default("")
  studentAvatar     String    @default("")
  requirements      String    @default("")
  leaveStatus       String    @default("none") // none | active | withdrawn
  leaveReason       String    @default("")
  leaveRequestedAt  DateTime?
  leaveWithdrawnAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([courseId, studentId])
  @@index([sessionId, leaveStatus])
}

model CourseSessionGroupLink {
  id        String   @id @default(uuid())
  courseId  String
  sessionId String
  groupId   String
  action    String   @default("include") // include | exclude
  createdAt DateTime @default(now())

  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  group   StudentGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([sessionId, groupId])
  @@index([courseId, groupId])
}

model CourseSessionCourseware {
  id           String   @id @default(uuid())
  courseId     String
  sessionId    String
  coursewareId String
  action       String   @default("exclude") // include | exclude
  createdAt    DateTime @default(now())

  course     Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session    CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  courseware Courseware    @relation(fields: [coursewareId], references: [id], onDelete: Cascade)

  @@unique([sessionId, coursewareId])
  @@index([courseId, coursewareId])
}

// ── Provider-neutral classroom recording attempts ──
model ClassroomRecording {
  id                  String    @id @default(uuid())
  courseId            String
  sessionId           String
  provider            String
  channelName         String
  recorderUserId      String
  status              String    @default("starting") // starting | recording | stopping | processing | completed | failed
  resourceId          String?
  providerSessionId   String? // Agora sid or another provider's recording session ID
  playbackObjectKey   String?
  files               Json?
  providerState       Json?
  errorMessage        String?
  mode                String    @default("mix") // web | mix
  fallbackFrom        String?
  retryCount          Int       @default(0)
  startRetryCount     Int       @default(0)
  stopRetryCount      Int       @default(0)
  stopRequestedAt     DateTime?
  lastProviderCheckAt DateTime?
  failureStage        String?
  playbackFormat      String?
  startedAt           DateTime?
  stoppedAt           DateTime? // Replay end boundary; provider exit is tracked in providerState.stopControl.confirmedAt
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([sessionId])
  @@index([courseId, status])
  @@index([providerSessionId])
}

// Provider callbacks are persisted before processing so duplicate or out-of-
// order webhook deliveries remain harmless.
model ClassroomProviderEvent {
  id          String    @id @default(uuid())
  noticeId    String    @unique
  provider    String
  category    String
  recordingId String?
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([recordingId, createdAt])
  @@index([provider, category, createdAt])
}

// ── Course ↔ Teacher (lecturers; includes the lead teacher) ──
model CourseTeacher {
  id            String   @id @default(uuid())
  courseId      String
  teacherId     String // Casdoor user ID
  teacherName   String   @default("")
  teacherAvatar String   @default("")
  createdAt     DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, teacherId])
  @@index([teacherId])
  @@index([courseId])
}

// ── Share link: teacher-created, revocable live or course enrollment link ──
model CourseJoinLink {
  id         String    @id @default(uuid())
  courseId   String
  sessionId  String?
  token      String    @unique
  purpose    String    @default("live") // live | course
  passcode   String? // Optional 6-digit passcode required before using this share link
  label      String    @default("")
  createdBy  String
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  useCount   Int       @default(0)
  createdAt  DateTime  @default(now())

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session CourseSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([sessionId])
  @@index([courseId, purpose])
  @@index([createdBy])
}

// ── Student Group (supports nested hierarchy) ──
model StudentGroup {
  id        String   @id @default(uuid())
  name      String
  parentId  String? // null = root group
  createdBy String // Teacher Casdoor user ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Self-relation for hierarchy
  parent   StudentGroup?  @relation("GroupHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children StudentGroup[] @relation("GroupHierarchy")

  // Relations
  members      GroupMember[]
  courseLinks  CourseGroupLink[]
  sessionLinks CourseSessionGroupLink[]

  @@index([parentId])
  @@index([createdBy])
}

// Durable idempotency record, independent of later group deletion.
model GroupCreationReceipt {
  actorId String
  requestId String
  groupId String
  name String
  parentId String?
  createdAt DateTime @default(now())

  @@id([actorId, requestId])
}

// Retained even if the class is removed, to prevent accidental recreation.
model CourseCreationReceipt {
  requestId String @id
  actorId String
  courseId String
  payloadHash String
  createdAt DateTime @default(now())
}

// ── Course ↔ Student (direct assignment) ──
model CourseStudent {
  id            String   @id @default(uuid())
  courseId      String
  studentId     String // Casdoor user ID
  studentName   String   @default("")
  studentAvatar String   @default("")
  joinedAt      DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId])
}

// ── Student classroom attendance sessions ──
model CourseAttendance {
  id            String    @id @default(uuid())
  courseId      String
  sessionId     String
  studentId     String
  studentName   String    @default("")
  studentAvatar String    @default("")
  enteredAt     DateTime  @default(now())
  leftAt        DateTime?
  durationSec   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([sessionId])
  @@index([studentId])
  @@index([courseId, studentId])
  @@index([courseId, enteredAt])
}

// ── Course ↔ StudentGroup (group assignment) ──
model CourseGroupLink {
  id       String   @id @default(uuid())
  courseId String
  groupId  String
  linkedAt DateTime @default(now())

  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  group  StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([courseId, groupId])
}

// ── Group ↔ Member ──
model GroupMember {
  id         String   @id @default(uuid())
  groupId    String
  userId     String // Casdoor user ID
  userName   String   @default("")
  userAvatar String   @default("")
  joinedAt   DateTime @default(now())

  group StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

// ── Courseware (Whiteboard materials / slides) ──
model Courseware {
  id                 String   @id @default(uuid())
  courseId           String
  sessionId          String?
  name               String
  ext                String // pdf, ppt, pptx, doc, docx, mp3, mp4, png, jpg, gif
  size               Int      @default(0) // size in bytes
  url                String // Original or converted entry URL
  taskUuid           String? // Agora projector task UUID
  taskStatus         String   @default("Pending") // Pending | Converting | Finished | Failed
  type               String   @default("static") // static | dynamic
  conversion         Json? // Store full Agora conversion JSON response (scenes/pages)
  studentCanView     Boolean  @default(true)
  studentCanDownload Boolean  @default(true)
  whiteboardEnabled  Boolean  @default(false)
  conversionError    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  course       Course                    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session      CourseSession?            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionRules CourseSessionCourseware[]

  @@index([courseId])
  @@index([sessionId])
}

// ── Authoritative live classroom state ──
model ClassroomRuntime {
  activityRevision Int @default(0)
  id                         String    @id @default(uuid())
  courseId                   String
  sessionId                  String    @unique
  status                     String    @default("waiting") // waiting | live | ended
  classStartMode String @default("manual") // manual (remind at scheduled time) | scheduled
  recordingStartMode         String    @default("classStart") // classStart | disabled; legacy scheduled modes are recording-only
  revision                   Int       @default(1)
  startedAt                  DateTime?
  graceEndsAt                DateTime?
  stageMode                  String    @default("auto") // auto | screen | whiteboard | spotlight
  stageLocked                Boolean   @default(false)
  stageStudentLimit          Int?
  stageInviteBypassLimit     Boolean   @default(true)
  screenDualStreamEnabled    Boolean   @default(false)
  spotlightUserId            String?
  activeCoursewareId         String?
  composition                Json      @default("{}")
  assistantPermissions       Json      @default("{}")
  chatEnabled                Boolean   @default(true)
  timerStartedAt             DateTime?
  timerDurationSec           Int?
  timerPausedAt              DateTime?
  captionStartPreferences    Json @default("{}")
  interpretationEnabled      Boolean   @default(false)
  interpretationProvider     String    @default("shengwang") // shengwang | wordly
  sourceLanguage             String    @default("zh-CN")
  targetLanguages            Json      @default("[]")
  transcriptionStatus        String    @default("stopped") // stopped | starting | running | recovering | stopping | failed
  transcriptionAgentId       String?
  transcriptionError         String?
  transcriptionRetryCount    Int       @default(0)
  transcriptionLastCheckedAt DateTime?
  transcriptionConfigKey     String?
  transcriptionSyncLeaseUntil DateTime?
  whiteboardProvider         String    @default("netless")
  whiteboardRoomUuid         String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  course           Course                     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session          CourseSession              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  members          ClassroomMemberState[]
  messages         ClassroomMessage[]
  captions         ClassroomCaption[]
  rewardEvents     ClassroomRewardEvent[]
  engagementRounds ClassroomEngagementRound[]
  activities       ClassroomActivity[]

  @@index([status])
  @@index([graceEndsAt])
}

model ClassroomMemberState {
  id                     String    @id @default(uuid())
  runtimeId              String
  courseId               String
  sessionId              String
  userId                 String
  displayName            String    @default("")
  avatar                 String    @default("")
  role                   String    @default("student") // teacher | assistant | student
  presence               String    @default("offline") // online | offline
  stageState             String    @default("offstage") // offstage | invited | accepted | left | waiting | removed | declined
  screenShareState       String    @default("idle") // idle | requested | accepted
  screenShareRequestedAt DateTime?
  onStage                Boolean   @default(false)
  microphoneAllowed      Boolean   @default(false)
  cameraAllowed          Boolean   @default(false)
  chatMuted              Boolean   @default(false)
  whiteboardWritable     Boolean   @default(false)
  handRaisedAt           DateTime?
  joinedAt               DateTime  @default(now())
  lastSeenAt             DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  runtime ClassroomRuntime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  course  Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session CourseSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([courseId, userId])
  @@index([runtimeId, presence])
  @@index([courseId, handRaisedAt])
  @@index([courseId, onStage])
  @@index([sessionId, screenShareState])
}

model ClassroomMessage {
  id          String    @id @default(uuid())
  runtimeId   String
  courseId    String
  sessionId   String
  senderId    String
  senderName  String
  senderRole  String
  spaceId     String?
  scope       String    @default("classroom") // classroom | room | staff | direct
  recipientId String?
  kind        String    @default("text") // text | system
  content     String
  deletedAt   DateTime?
  deletedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  runtime ClassroomRuntime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  course  Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session CourseSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  space   ClassroomSpace?  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
  @@index([sessionId, createdAt])
  @@index([sessionId, scope, createdAt, id])
  @@index([runtimeId, createdAt])
  @@index([spaceId, createdAt])
  @@index([courseId, scope, createdAt])
}

// ── Large-class orchestration spaces ──
// RTC channels remain provider-neutral strings. A large class keeps one main
// broadcast and may add independent breakout spaces with their own assistant,
// roster, whiteboard and question queue.
model ClassroomSpace {
  id                 String   @id @default(uuid())
  courseId           String
  sessionId          String
  kind               String   @default("breakout") // main | breakout
  name               String
  channelName        String   @unique
  status             String   @default("waiting") // waiting | open | closed
  position           Int
  capacity           Int?
  whiteboardRoomUuid String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  course    Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session   CourseSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  members   ClassroomSpaceMember[]
  messages  ClassroomMessage[]
  questions ClassroomQuestion[]

  @@unique([sessionId, position])
  @@index([courseId, status])
  @@index([sessionId, status])
}

model ClassroomSpaceMember {
  id                 String    @id @default(uuid())
  courseId           String
  sessionId          String
  spaceId            String
  userId             String
  displayName        String    @default("")
  avatar             String    @default("")
  role               String    @default("student") // assistant | student
  active             Boolean   @default(true)
  microphoneAllowed  Boolean   @default(true)
  cameraAllowed      Boolean   @default(true)
  screenShareAllowed Boolean   @default(false)
  assignedAt         DateTime  @default(now())
  joinedAt           DateTime?
  leftAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session CourseSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  space   ClassroomSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([courseId, userId])
  @@index([sessionId, userId])
  @@index([spaceId, role, active])
}

model ClassroomQuestion {
  id         String    @id @default(uuid())
  courseId   String
  sessionId  String
  spaceId    String?
  askerId    String
  askerName  String    @default("")
  content    String
  status     String    @default("open") // open | promoted | answered | dismissed
  promotedBy String?
  answeredBy String?
  answer     String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  updatedAt  DateTime  @updatedAt

  course  Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session CourseSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  space   ClassroomSpace? @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([courseId, status, createdAt])
  @@index([sessionId, status, createdAt])
  @@index([spaceId, status, createdAt])
}

// ── In-class engagement ──
// Reward events remain immutable so lesson reports can aggregate the exact
// teaching activity later.
model ClassroomRewardEvent {
  id          String   @id @default(uuid())
  runtimeId   String
  courseId    String
  sessionId   String
  giverId     String
  recipientId String
  points      Int      @default(1)
  createdAt   DateTime @default(now())

  runtime ClassroomRuntime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  course  Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session CourseSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, recipientId])
  @@index([runtimeId, createdAt])
}

model ClassroomEngagementRound {
  id            String    @id @default(uuid())
  runtimeId     String
  courseId      String
  sessionId     String
  kind          String // buzz | selector
  status        String    @default("active") // active | closed
  startedById   String
  winnerUserId  String?
  resultUserIds Json      @default("[]")
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  runtime   ClassroomRuntime              @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  course    Course                        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session   CourseSession                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  responses ClassroomEngagementResponse[]

  @@index([sessionId, kind, status])
  @@index([runtimeId, createdAt])
}

model ClassroomEngagementResponse {
  id          String   @id @default(uuid())
  roundId     String
  sessionId   String
  userId      String
  isWinner    Boolean  @default(false)
  respondedAt DateTime @default(now())

  round ClassroomEngagementRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
  @@index([sessionId, respondedAt])
}

// ── Provider-neutral ASR captions and translated text ──
model ClassroomCaption {
  id               String   @id @default(uuid())
  runtimeId        String
  courseId         String
  sessionId        String
  externalId       String
  provider         String   @default("shengwang")
  speakerId        String   @default("")
  speakerName      String   @default("")
  sourceLanguage   String   @default("")
  detectedLanguage String   @default("")
  text             String
  translations     Json     @default("{}")
  isFinal          Boolean  @default(false)
  occurredAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  runtime ClassroomRuntime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  course  Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session CourseSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, externalId])
  @@index([courseId, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([runtimeId, occurredAt])
}

// ── Teacher-reviewed post-class notes generated from final ASR captions ──
model CourseSessionSummary {
  id              String   @id @default(uuid())
  courseId        String
  sessionId       String   @unique
  status          String   @default("draft") // draft | published
  document        Json     @default("{}")
  captionCount    Int      @default(0)
  sourceUpdatedAt DateTime?
  generatedBy     String   @default("system")
  generatedAt     DateTime @default(now())
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([courseId, status, updatedAt])
  @@index([sessionId, status])
}

// Durable generation status is independent of the teacher's editable/published summary.
model CourseSessionSummaryGeneration {
  sessionId     String   @id
  courseId      String
  status        String   @default("queued") // queued | running | completed | failed
  requestId     String   @default(uuid())
  requestedBy   String   @default("system")
  attempts      Int      @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  nextAttemptAt DateTime @default(now())
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

// Each browser tab/device has an independent media and presence lease.
// Stored separately from screen video. An active row is not an input credential:
// every use must revalidate the current roster, connections and share claim.
model ClassroomRemoteControlGrant {
  id              String   @id
  sessionId       String
  teacherId       String
  teacherClientId String
  studentId       String
  studentClientId String
  shareClaimId    String
  channelPublicKey String?
  receiverReady   Boolean  @default(false)
  state           String
  requestedAt     DateTime
  expiresAt       DateTime
  updatedAt       DateTime @updatedAt
  session         CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([sessionId, teacherId])
  @@index([expiresAt])
}

model ClassroomConnection {
  id String @id
  sessionId String
  userId String
  rtcUid Int
  screenUid Int
  captionLanguage String?
  deviceId String?
  deviceLabel String?
  entryMode String?
  replacedAt DateTime?
  leaveIntent String? // temporary | finishIfLastTeacher | disconnected; null for legacy clients
  lastSeenAt DateTime @default(now())
  leftAt DateTime?
  @@index([sessionId, userId, lastSeenAt])
}

// Keep the historical progress table in the schema so schema tools preserve it.
model CoursePlaybackProgress {
  id                  String   @id @default(uuid())
  courseId            String
  studentId           String
  studentName         String   @default("")
  studentAvatar       String   @default("")
  firstViewedAt       DateTime @default(now())
  lastViewedAt        DateTime @default(now())
  totalDurationSec    Int      @default(0)
  sessionCount        Int      @default(0)
  activeSessionId     String?
  playbackLessonId    String?
  heartbeatNonceHash  String?
  lastHeartbeatAt     DateTime?
  lastPositionSec     Float?
  lastPlaybackRate    Float?
  lastPlaybackState   String   @default("inactive")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  course              Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([courseId])
  @@index([studentId])
  @@index([courseId, lastViewedAt])
}

// Persistent classroom polls, quizzes and text tasks. Runtime owns the session.
model ClassroomActivity {
  id          String   @id @default(uuid())
  runtimeId   String
  sessionId   String
  requestId   String
  creationFingerprint String?
  createdBy   String
  title       String
  kind        String
  definition  Json
  status      String   @default("draft")
  version     Int      @default(1)
  presented   Boolean  @default(false)
  presentedQuestion Int @default(0)
  durationSec Int?
  startedAt   DateTime?
  deadlineAt  DateTime?
  closedAt    DateTime?
  publishedAt DateTime?
  answerReleaseScope String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  runtime     ClassroomRuntime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  submissions ClassroomActivitySubmission[]
  reminders   ClassroomActivityReminder[]

  @@unique([sessionId, requestId])
  @@index([sessionId, createdAt])
}

model ClassroomActivitySubmission {
  id          String   @id @default(uuid())
  activityId  String
  userId      String
  displayName String
  answers     Json
  answerHistory Json @default("[]")
  answerVersion Int @default(1)
  aiReview    Json @default("{}")
  grading     Json
  feedback    String   @default("")
  version     Int      @default(1)
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  activity    ClassroomActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([activityId, id])
}

model ClassroomActivityReminder {
  id          String @id @default(uuid())
  activityId  String
  requestId   String
  senderId    String
  recipients  Json
  createdAt   DateTime @default(now())
  activity    ClassroomActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, requestId])
  @@index([activityId, createdAt])
}

// Transactional, coalesced invalidations for ephemeral Redis classroom state.
model ClassroomRedisSync {
  sessionId     String   @id
  version       BigInt   @default(autoincrement())
  processedAt   DateTime?
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?
  updatedAt     DateTime @default(now())
  controlRefreshedAt DateTime?

  @@index([controlRefreshedAt])
  @@index([processedAt, nextAttemptAt])
}

model ClassroomCacheVersion {
  sessionId String
  topic String
  version BigInt @default(1)
  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@id([sessionId, topic])
}


model ClassroomChatImage {
  id          String @id
  sessionId   String
  uploaderId  String
  objectKey   String @unique
  sourceHash  String
  contentType String @default("image/webp")
  bytes       Int
  width       Int
  height      Int
  createdAt   DateTime @default(now())
  session     CourseSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  @@index([sessionId,uploaderId,createdAt])
}

model ClassroomScreenInkAsset {
  id          String @id
  sessionId   String
  uploaderId  String
  clientId    String
  claimId     String
  objectKey   String @unique
  sourceHash  String
  bytes       Int
  width       Int
  height      Int
  createdAt   DateTime @default(now())
  session     CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, uploaderId, createdAt])
}

// Personal teaching tasks are scoped to the authenticated account.
model WorkspaceTask {
  id String @id @default(uuid())
  userId String
  requestId String
  title String
  notes String @default("")
  dueDate String?
  courseId String?
  sessionId String?
  completed Boolean @default(false)
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course Course? @relation(fields:[courseId], references:[id], onDelete:SetNull)
  session CourseSession? @relation(fields:[sessionId], references:[id], onDelete:SetNull)

  @@unique([userId, requestId])
  @@index([userId, completed, createdAt])
  @@index([userId, courseId])
  @@index([sessionId])
}

// Private calendar events store instants and the creator's scheduling zone.
model WorkspaceEvent {
  id String @id @default(uuid())
  userId String
  requestId String
  title String
  notes String @default("")
  startsAt DateTime
  endsAt DateTime
  timeZone String
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, requestId])
  @@index([userId, startsAt])
  @@index([userId, endsAt])
}

// Keep creation receipts after an event is deleted so retries cannot recreate it.
model WorkspaceEventReceipt {
  userId String
  requestId String
  eventId String
  title String?
  notes String?
  startsAt DateTime?
  endsAt DateTime?
  timeZone String?
  createdAt DateTime @default(now())

  @@id([userId, requestId])
}

// Long-lived course conversations are distinct from live lesson chat.
model WorkspaceMessage {
  id String @id @default(uuid())
  courseId String
  senderId String
  senderName String
  clientId String
  content String
  createdAt DateTime @default(now())
  course Course @relation(fields:[courseId], references:[id], onDelete:Cascade)

  @@unique([courseId, senderId, clientId])
  @@index([courseId, createdAt, id])
}

model WorkspaceChatRead {
  courseId String
  userId String
  lastCreatedAt DateTime
  lastMessageId String
  updatedAt DateTime @updatedAt
  course Course @relation(fields:[courseId], references:[id], onDelete:Cascade)
  @@id([courseId,userId])
}

// Direct conversations are anchored to a class, whose access policy also
// controls who may continue reading after membership changes.
model WorkspaceDirectChat {
  id String @id @default(uuid())
  courseId String
  participantA String
  participantB String
  createdAt DateTime @default(now())
  course Course @relation(fields:[courseId], references:[id], onDelete:Cascade)
  messages WorkspaceDirectMessage[]
  reads WorkspaceDirectRead[]

  @@unique([courseId, participantA, participantB])
  @@index([participantA])
  @@index([participantB])
}

model WorkspaceDirectMessage {
  id String @id @default(uuid())
  chatId String
  senderId String
  senderName String
  clientId String
  content String
  createdAt DateTime @default(now())
  chat WorkspaceDirectChat @relation(fields:[chatId], references:[id], onDelete:Cascade)

  @@unique([chatId, senderId, clientId])
  @@index([chatId, createdAt, id])
}

model WorkspaceDirectRead {
  chatId String
  userId String
  lastCreatedAt DateTime
  lastMessageId String
  updatedAt DateTime @updatedAt
  chat WorkspaceDirectChat @relation(fields:[chatId], references:[id], onDelete:Cascade)
  @@id([chatId,userId])
}

model WorkspaceDriveItem {
  id String @id @default(uuid())
  userId String
  requestId String
  parentId String?
  kind String
  name String
  size Int @default(0)
  contentType String @default("application/octet-stream")
  objectKey String? @unique
  status String @default("ready")
  trashRootId String?
  lastOpenedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent WorkspaceDriveItem? @relation("DriveTree", fields:[parentId], references:[id], onDelete:Restrict)
  children WorkspaceDriveItem[] @relation("DriveTree")

  @@unique([userId, requestId])
  @@index([userId, parentId, status, createdAt])
  @@index([userId, trashRootId, status])
  @@index([userId, status, lastOpenedAt, id])
}

// Durable audit and idempotency receipt for batch lesson staff changes.
model CourseStaffGrantReceipt {
  id String @id @default(uuid())
  actorId String
  requestId String
  courseId String
  payloadHash String
  changes Json
  createdAt DateTime @default(now())

  @@unique([actorId, requestId])
  @@index([courseId, createdAt])
}
