{
  "name": "@xiangyu/classroom-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Secure Electron classroom shell for Xiangyu Wenshu Live.",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "electron .",
    "package": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "cn.xiangyuwenshu.classroom",
    "productName": "翔宇文淑课堂",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "extendInfo": {
        "NSCameraUsageDescription": "在课堂中开启摄像头，让老师和同学看到你的画面。",
        "NSMicrophoneUsageDescription": "在课堂中使用麦克风发言。"
      }
    },
    "win": {
      "target": "nsis"
    }
  }
}
