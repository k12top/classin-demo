# Copy this file to `.env.local` for local development.
# Keep every secret server-only: never add NEXT_PUBLIC_ to secret variables and
# never commit `.env.local`. NEXT_PUBLIC_ values are embedded at build time.

# -----------------------------------------------------------------------------
# Required: database, sessions, authentication, and scheduled lifecycle jobs
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/classroom
SESSION_SECRET=
SHARE_ACCESS_SECRET=
CRON_SECRET=

NEXT_PUBLIC_CASDOOR_SERVER_URL=
NEXT_PUBLIC_CASDOOR_CLIENT_ID=
NEXT_PUBLIC_CASDOOR_APP_NAME=
NEXT_PUBLIC_CASDOOR_ORG_NAME=
NEXT_PUBLIC_CASDOOR_OAUTH_SCOPE=read
CASDOOR_CLIENT_SECRET=
# Optional server-only auth endpoint fallback. Omit when
# NEXT_PUBLIC_CASDOOR_SERVER_URL is configured.
CASDOOR_SERVER_URL=

# Optional database tuning. These values are already the production defaults.
DATABASE_POOL_MAX=3
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_IDLE_TIMEOUT_MS=300000
DATABASE_CONNECTION_MAX_LIFETIME_SECONDS=900
DATABASE_READ_RETRIES=1

# -----------------------------------------------------------------------------
# Required for live classroom audio/video: Agora / Shengwang RTC
# -----------------------------------------------------------------------------
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# REST credentials are additionally required by cloud recording and Agora ASR.
# Use these canonical names; do not also configure legacy SHENGWANG_* aliases.
AGORA_REST_CUSTOMER_ID=
AGORA_REST_CUSTOMER_SECRET=
AGORA_API_BASE_URL=https://api.sd-rtn.com

# Provider and UI selectors. All values below already have these defaults.
CLASSROOM_MEDIA_PROVIDER=agora
CLASSROOM_RECORDING_PROVIDER=agora
CLASSROOM_UI_VERSION=v3
# Used only when CLASSROOM_UI_VERSION=rollout.
CLASSROOM_V3_ROLLOUT_PERCENT=0
CLASSROOM_V3_LAYOUT=classin

# -----------------------------------------------------------------------------
# Required for courseware upload and cloud-recording output: Alibaba Cloud OSS
# -----------------------------------------------------------------------------
ALIYUN_OSS_REGION=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
# Optional prefix; defaults to courseware.
ALIYUN_OSS_COURSEWARE_PREFIX=courseware

# -----------------------------------------------------------------------------
# Required for Agora cloud recording and reliable recording state callbacks
# -----------------------------------------------------------------------------
# Numeric Agora storage-region ID, not an OSS endpoint. Singapore OSS uses 10.
AGORA_RECORDING_STORAGE_REGION=10
# Standard Cloud Recording uses /v1/apps without a region path prefix. Keep
# empty unless Shengwang explicitly provisions a regional path for this app.
AGORA_RECORDING_API_REGION=
AGORA_RECORDING_WEBHOOK_SECRET=

# Optional recording overrides. The storage endpoint is derived automatically
# from ALIYUN_OSS_BUCKET and ALIYUN_OSS_REGION when left empty.
AGORA_RECORDING_STORAGE_ENDPOINT=
AGORA_RECORDING_REGION_AFFINITY=2
AGORA_RECORDING_MAX_IDLE_SECONDS=300
AGORA_RECORDING_PREFIX=recordings

# Required for browser-composited recording (whiteboard, stage, and overlays).
# Production origin must expose /classroom/recorder. Vercel previews use their
# own VERCEL_URL so the recorder loads the same deployment that started it.
CLASSROOM_PUBLIC_BASE_URL=
CLASSROOM_RECORDER_SECRET=
# Maximum process duration is capped at 6 hours. Files are split into
# four-minute segments to improve recovery and playback reliability.
AGORA_PAGE_RECORDING_MAX_HOURS=6
# Keep false unless degraded RTC-only recording without whiteboard/DOM content
# is explicitly acceptable when browser composition fails.
AGORA_ALLOW_RAW_MIX_FALLBACK=false

# -----------------------------------------------------------------------------
# Optional capability: live captions and translation
# -----------------------------------------------------------------------------
# Agora ASR reuses AGORA_APP_* and AGORA_REST_* above.
AGORA_STT_ENABLED=true
AGORA_STT_REGION=cn
AGORA_STT_MAX_IDLE_SECONDS=300

# Configure only when the optional Wordly bridge is deployed. The token must
# equal that bridge service's BRIDGE_INTERNAL_TOKEN.
WORDLY_API_URL=
WORDLY_INTERNAL_TOKEN=

# -----------------------------------------------------------------------------
# Optional capability: AI-generated post-class summary
# -----------------------------------------------------------------------------
# With this disabled or unconfigured, deterministic caption extraction remains
# available. To enable AI, set ENABLED=true plus API_KEY and MODEL.
AI_SUMMARY_ENABLED=false
AI_SUMMARY_BASE_URL=https://api.openai.com/v1
AI_SUMMARY_API_KEY=
AI_SUMMARY_MODEL=gpt-4.1-mini
# responses (OpenAI default) or chat-completions (compatible gateways)
AI_SUMMARY_API_STYLE=responses
AI_SUMMARY_LANGUAGE=zh-CN
AI_SUMMARY_TIMEOUT_SECONDS=180
AI_SUMMARY_MAX_CAPTIONS=2000
AI_SUMMARY_RETRY_COUNT=3

# -----------------------------------------------------------------------------
# Optional capability: Netless Fastboard whiteboard
# -----------------------------------------------------------------------------
WHITEBOARD_APP_IDENTIFIER=
WHITEBOARD_SDK_TOKEN=
WHITEBOARD_REGION=sg

# -----------------------------------------------------------------------------
# Optional product defaults and public branding
# -----------------------------------------------------------------------------
COURSE_EARLY_ENTRY_MINUTES=60
COURSE_FINISHED_DELAY_MINUTES=20
NEXT_PUBLIC_CLASSROOM_VIDEO_PRESET=hd
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_TITLE=
NEXT_PUBLIC_SITE_LOGO=/site-logo.svg
NEXT_PUBLIC_SITE_ICON=
