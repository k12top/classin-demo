# Database. Apply committed migrations with `npm run db:migrate`.
DATABASE_URL=postgresql://user:password@host:5432/classroom
DATABASE_POOL_MAX=3
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_IDLE_TIMEOUT_MS=300000
DATABASE_READ_RETRIES=1

# Classroom providers
CLASSROOM_UI_VERSION=v3
# classin (default) or legacy. Allows an immediate UI-only rollback.
CLASSROOM_V3_LAYOUT=classin
CLASSROOM_MEDIA_PROVIDER=agora
CLASSROOM_RECORDING_PROVIDER=agora

# Shengwang RTC, REST, cloud recording, and speech-to-text
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_REST_CUSTOMER_ID=
AGORA_REST_CUSTOMER_SECRET=
AGORA_API_BASE_URL=https://api.sd-rtn.com
AGORA_STT_ENABLED=true
AGORA_STT_REGION=cn
AGORA_STT_MAX_IDLE_SECONDS=300
AGORA_RECORDING_STORAGE_REGION=10
AGORA_RECORDING_API_REGION=ap
AGORA_RECORDING_REGION_AFFINITY=2
AGORA_RECORDING_STORAGE_ENDPOINT=https://bucket-name.oss-ap-southeast-1.aliyuncs.com
AGORA_RECORDING_WEBHOOK_SECRET=
AGORA_RECORDING_MAX_IDLE_SECONDS=300
AGORA_RECORDING_PREFIX=recordings

# Optional Wordly translation bridge. This token must equal the bridge
# service's BRIDGE_INTERNAL_TOKEN.
WORDLY_API_URL=
WORDLY_INTERNAL_TOKEN=

# Optional AI-generated post-class summary. When disabled or unavailable the
# server falls back to deterministic caption extraction, so lesson closure is
# never blocked by the model provider.
AI_SUMMARY_ENABLED=false
AI_SUMMARY_BASE_URL=https://api.openai.com/v1
AI_SUMMARY_API_KEY=
AI_SUMMARY_MODEL=gpt-4.1-mini
# responses (OpenAI default) or chat-completions (compatible gateways)
AI_SUMMARY_API_STYLE=responses
AI_SUMMARY_LANGUAGE=zh-CN
AI_SUMMARY_TIMEOUT_SECONDS=180
AI_SUMMARY_MAX_CAPTIONS=2000
AI_SUMMARY_RETRY_COUNT=3

# Alibaba Cloud OSS (courseware and recording output)
ALIYUN_OSS_REGION=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_COURSEWARE_PREFIX=courseware

# Optional full-page recording and whiteboard
CLASSROOM_PUBLIC_BASE_URL=
CLASSROOM_RECORDER_SECRET=
# Cloud recorder and all media credentials are valid for at most 6 hours.
# Video output remains split into four-minute files for safer recovery/playback.
AGORA_PAGE_RECORDING_MAX_HOURS=6
# Keep disabled to guarantee that browser-rendered whiteboard and stage
# overlays remain in the recorded composite.
AGORA_ALLOW_RAW_MIX_FALLBACK=false
WHITEBOARD_APP_IDENTIFIER=
WHITEBOARD_SDK_TOKEN=
WHITEBOARD_REGION=sg

# Lifecycle and safe media defaults
COURSE_EARLY_ENTRY_MINUTES=60
COURSE_FINISHED_DELAY_MINUTES=20
NEXT_PUBLIC_CLASSROOM_VIDEO_PRESET=hd
NEXT_PUBLIC_SITE_LOGO=/site-logo.svg
