# Database. Apply committed migrations with `npm run db:migrate`.
DATABASE_URL=postgresql://user:password@host:5432/classroom

# Classroom providers
CLASSROOM_UI_VERSION=v3
CLASSROOM_MEDIA_PROVIDER=agora
CLASSROOM_RECORDING_PROVIDER=agora

# Shengwang RTC, REST, cloud recording, and speech-to-text
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_REST_CUSTOMER_ID=
AGORA_REST_CUSTOMER_SECRET=
AGORA_API_BASE_URL=https://api.sd-rtn.com
AGORA_STT_ENABLED=true
AGORA_STT_REGION=cn
AGORA_STT_MAX_IDLE_SECONDS=300
AGORA_RECORDING_STORAGE_REGION=
AGORA_RECORDING_MAX_IDLE_SECONDS=300
AGORA_RECORDING_PREFIX=recordings

# Optional Wordly translation bridge. This token must equal the bridge
# service's BRIDGE_INTERNAL_TOKEN.
WORDLY_API_URL=
WORDLY_INTERNAL_TOKEN=

# Alibaba Cloud OSS (courseware and recording output)
ALIYUN_OSS_REGION=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_COURSEWARE_PREFIX=courseware

# Optional full-page recording and whiteboard
CLASSROOM_PUBLIC_BASE_URL=
CLASSROOM_RECORDER_SECRET=
AGORA_PAGE_RECORDING_MAX_HOURS=8
WHITEBOARD_APP_IDENTIFIER=
WHITEBOARD_SDK_TOKEN=
WHITEBOARD_REGION=sg

# Lifecycle and safe media defaults
COURSE_EARLY_ENTRY_MINUTES=60
COURSE_FINISHED_DELAY_MINUTES=20
NEXT_PUBLIC_CLASSROOM_VIDEO_PRESET=hd
