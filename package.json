{
  "name": "classroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:clean": "rm -rf .next && next dev --webpack",
    "build": "next build --webpack",
    "build:deploy": "npm run db:migrate && npm run build",
    "start": "next start",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma migrate deploy",
    "db:push:unsafe": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@netless/fastboard": "^1.1.8",
    "@netless/window-manager": "^1.0.17",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "agora-rtc-sdk-ng": "^4.24.7",
    "agora-rtm": "^2.3.0",
    "agora-token": "^2.0.5",
    "ali-oss": "^6.23.0",
    "casdoor-js-sdk": "^0.19.0",
    "casdoor-nodejs-sdk": "^1.34.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
