    "jspdf": "2.5.1",
    "lucide-react": "^1.16.0",
    "md5": "^2.3.0",
    "motion": "^12.42.2",
    "next": "16.2.6",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "proxy-agent": "^5.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "white-web-sdk": "^2.16.56"
