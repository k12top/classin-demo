{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Xiangyu Classroom",
    "version": "1.0.0",
    "description": "Shared primitives for web, Electron, Flutter and HarmonyOS NEXT classroom clients."
  },
  "color": {
    "obsidian": { "$type": "color", "$value": "#090A0D" },
    "graphite": { "$type": "color", "$value": "#15171C" },
    "surface": { "$type": "color", "$value": "#1D2027" },
    "frost": { "$type": "color", "$value": "#F4F6F8" },
    "mist": { "$type": "color", "$value": "#A7AFBD" },
    "iris": { "$type": "color", "$value": "#7B6FF2" },
    "signal": { "$type": "color", "$value": "#32D49A" },
    "coral": { "$type": "color", "$value": "#FF5E69" },
    "amber": { "$type": "color", "$value": "#F8C35A" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": ["-apple-system", "BlinkMacSystemFont", "PingFang SC", "Segoe UI", "sans-serif"]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["SFMono-Regular", "Cascadia Code", "Roboto Mono", "monospace"]
    }
  },
  "space": {
    "2": { "$type": "dimension", "$value": "2px" },
    "4": { "$type": "dimension", "$value": "4px" },
    "8": { "$type": "dimension", "$value": "8px" },
    "12": { "$type": "dimension", "$value": "12px" },
    "16": { "$type": "dimension", "$value": "16px" },
    "20": { "$type": "dimension", "$value": "20px" },
    "24": { "$type": "dimension", "$value": "24px" },
    "32": { "$type": "dimension", "$value": "32px" }
  },
  "radius": {
    "control": { "$type": "dimension", "$value": "12px" },
    "panel": { "$type": "dimension", "$value": "18px" },
    "stage": { "$type": "dimension", "$value": "22px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "motion": {
    "quick": { "$type": "duration", "$value": "160ms" },
    "standard": { "$type": "duration", "$value": "240ms" },
    "slow": { "$type": "duration", "$value": "360ms" },
    "easing": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] }
  },
  "breakpoint": {
    "phone": { "$type": "dimension", "$value": "600px" },
    "tablet": { "$type": "dimension", "$value": "1024px" },
    "desktop": { "$type": "dimension", "$value": "1280px" }
  }
}
